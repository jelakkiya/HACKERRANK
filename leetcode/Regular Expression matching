#include <string>
#include <vector>

using namespace std;

class Solution {
public:
    bool isMatch(string s, string p) {
        int m = s.length(), n = p.length();
        // memo[i][j] stores whether s[i:] matches p[j:]
        vector<vector<int>> memo(m + 1, vector<int>(n + 1, -1));
        return dp(0, 0, s, p, memo);
    }

private:
    bool dp(int i, int j, string& s, string& p, vector<vector<int>>& memo) {
        if (memo[i][j] != -1) return memo[i][j];
        
        // Base case: if pattern is exhausted, s must also be exhausted
        if (j == p.length()) return i == s.length();

        // Check if the current characters match
        bool first_match = (i < s.length() && (p[j] == s[i] || p[j] == '.'));

        bool res;
        // Handle '*' wildcard
        if (j + 1 < p.length() && p[j + 1] == '*') {
            // Choice 1: Skip '*' and the preceding char (match zero times)
            // Choice 2: Use '*' if first_match is true (match one or more times)
            res = dp(i, j + 2, s, p, memo) || 
                  (first_match && dp(i + 1, j, s, p, memo));
        } else {
            // No '*', proceed to the next characters
            res = first_match && dp(i + 1, j + 1, s, p, memo);
        }

        return memo[i][j] = res;
    }
};
