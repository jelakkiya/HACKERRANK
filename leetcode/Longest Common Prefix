class Solution:
    def longestCommonPrefix(self, strs: list[str]) -> str:
        if not strs:
            return ""
        
        # Sort to compare only the most different strings
        strs.sort()
        first = strs[0]
        last = strs[-1]
        
        res = ""
        for i in range(min(len(first), len(last))):
            if first[i] != last[i]:
                return res
            res += first[i]
            
        return res
