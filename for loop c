#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int a, b;
    // Read the two integers
    scanf("%d\n%d", &a, &b);
    
    // Array to store English representations for numbers 1 to 9
    // We use a 2D char array where the index matches the number
    char *labels[] = {"", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"};

    for (int i = a; i <= b; i++) {
        if (i >= 1 && i <= 9) {
            // Print the string at the current index
            printf("%s\n", labels[i]);
        } else {
            // Check if the number is even or odd for i > 9
            if (i % 2 == 0) {
                printf("even\n");
            } else {
                printf("odd\n");
            }
        }
    }

    return 0;
}
