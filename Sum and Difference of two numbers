#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main()
{
    int n, m;
    float f1, f2;
    
    // 1. Read two integers from the first line
    scanf("%d %d", &n, &m);
    
    // 2. Read two floats from the second line
    scanf("%f %f", &f1, &f2);
    
    // 3. Print integer sum and difference
    printf("%d %d\n", n + m, n - m);
    
    // 4. Print float sum and difference rounded to one decimal place
    printf("%.1f %.1f\n", f1 + f2, f1 - f2);
    
    return 0;
}
