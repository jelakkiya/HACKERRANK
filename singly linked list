# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next

class Solution:
    def addTwoNumbers(self, l1: ListNode, l2: ListNode) -> ListNode:
        # Dummy node acts as a placeholder for the start of the list
        dummy = ListNode(0)
        current = dummy
        carry = 0
        
        # Continue as long as there are nodes to process or a leftover carry
        while l1 or l2 or carry:
            # Get values from nodes, default to 0 if list is exhausted
            val1 = l1.val if l1 else 0
            val2 = l2.val if l2 else 0
            
            # Calculate total and carry
            total = val1 + val2 + carry
            carry = total // 10
            new_digit = total % 10
            
            # Create new node and move pointer
            current.next = ListNode(new_digit)
            current = current.next
            
            # Move to next nodes in input lists
            if l1: l1 = l1.next
            if l2: l2 = l2.next
            
        return dummy.next
